# Copy to .env in this directory (repo root). Docker Compose loads it automatically.
# chmod 600 .env
#
# Docker Hub (docker-compose.yml uses pre-built images):
#   DOCKERHUB_USERNAME=your-dockerhub-username
#
# env_file for go-service and python-service; VITE_* below document expected client config
# (baked into frontend image when you build/push, not substituted at pull time).
#
DOCKERHUB_USERNAME=

# Compose overrides DATABASE_URL, REDIS_ADDR, AGENT_BASE_URL, FIREBASE_CREDENTIALS_PATH (go),
# and REDIS_URL (python) for the Docker network — values below are for local reference / non-Docker use.

# --- Frontend (Vite build; baked into static bundle) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_API_URL=http://localhost:8080

# --- Go API (runtime in container; Compose overrides URLs for Docker) ---
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dis_connect?sslmode=disable
REDIS_ADDR=localhost:6379
AGENT_BASE_URL=http://localhost:8000
FIREBASE_CREDENTIALS_PATH=./secret/firebase-service-account.json

# --- Python agent (runtime; Compose overrides REDIS_URL for Docker) ---
REDIS_URL=redis://localhost:6379
LITELLM_PRIMARY_MODEL=groq/llama-3.1-8b-instant
LITELLM_FALLBACK_MODEL_1=gemini/gemini-2.0-flash
LITELLM_FALLBACK_MODEL_2=
GROQ_API_KEY=
GOOGLE_API_KEY=
YOUTUBE_API_KEY_1=
YOUTUBE_API_KEY_2=
YOUTUBE_API_KEY_3=
